{
  "name": "OpenBuildsCONTROL",
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "description": "CBC CNC Machine Host Software",
  "author": "github.com/openbuilds <support@openbuilds.com>",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "@electron/notarize": "2.3.2"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/notarize": "2.3.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "electron": "45.1.0",
    "electron-builder": "^24.9.1",
    "electron-builder-notarize": "1.5.2",
    "electron-rebuild": "^3.2.9",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "ncp": "^2.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@serialport/parser-readline": "12.0.0",
    "detect-rpi": "^1.4.0",
    "electron-updater": "^5.2.1",
    "evilscan": "^1.9.1",
    "express": "^4.18.1",
    "formidable": "^2.1.1",
    "https": "^1.0.0",
    "ip": "^1.1.8",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "mkdirp": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "ncp": "^2.0.0",
    "node-abi": "^3.33.0",
    "node-gyp": "^9.3.1",
    "serialport": "^12.0.0",
    "socket.io": "^4.6.1",
    "systeminformation": "^5.23.5",
    "xmodem.js": "^0.1.0"
  },
  "main": "index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm run build && node dist/checks/scripts/dev.js",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:desktop": "npm run build && playwright test --config playwright.desktop.config.ts",
    "package": "npm run build && node dist/checks/scripts/package.js",
    "verify:package": "node dist/checks/scripts/verify-package.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.e2e.json && tsc -p tsconfig.renderer.json",
    "build": "npm run typecheck && tsc -p tsconfig.build.json && tsc -p tsconfig.machine.json && node dist/checks/scripts/build-browser.js",
    "lint": "eslint scripts src tests/toolchain tests/e2e tests/desktop playwright.config.ts playwright.desktop.config.ts vitest.config.mts --max-warnings=0",
    "format:check": "prettier --check scripts src tests/toolchain tests/e2e tests/desktop .github/workflows playwright.config.ts playwright.desktop.config.ts vitest.config.mts eslint.config.mjs tsconfig*.json .prettierrc.json package.json electron-builder.unsigned.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "release": "echo \"When you want to create a new release, follow these steps:\" && echo \"1) Update the version in your project's package.json file (e.g. 1.0.3xx)\" && echo \"2) Commit that change (git commit -am v1.0.3xx)\" && echo \"3) Push your changes to GitHub (git push)\"",
    "run-local": "npm run build && electron .",
    "verify:install": "npm run build && node dist/checks/scripts/verify-install.js",
    "postinstall": "install-electron --no && electron-builder install-app-deps"
  },
  "keywords": [
    "usb"
  ],
  "repository": "https://github.com/OpenBuilds/OpenBuilds-CONTROL",
  "build": {
    "publish": [
      {
        "provider": "github",
        "vPrefixedTagName": true
      }
    ],
    "afterSign": "./notarize.js",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "icon": "build/icon.icns",
    "appId": "openbuilds.control",
    "productName": "CBC",
    "asar": true,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "license": "build/licence.txt",
      "installerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "obc",
        "name": "OpenBuilds CAM Project",
        "description": "OpenBuilds CAM Project",
        "role": "Viewer"
      },
      {
        "ext": "gcode",
        "name": "GCODE File",
        "description": "GCODE File",
        "role": "Viewer"
      },
      {
        "ext": "gc",
        "name": "GCODE File",
        "description": "GCODE File",
        "role": "Viewer"
      },
      {
        "ext": "tap",
        "name": "GCODE File",
        "description": "GCODE File",
        "role": "Viewer"
      },
      {
        "ext": "nc",
        "name": "GCODE File",
        "description": "GCODE File",
        "role": "Viewer"
      },
      {
        "ext": "cnc",
        "name": "GCODE File",
        "description": "GCODE File",
        "role": "Viewer"
      }
    ],
    "files": [
      "**/*",
      "ssl/**/*",
      "firmware/**/*",
      ""
    ],
    "extraFiles": [
      "ssl"
    ],
    "asarUnpack": [
      "esptool.exe",
      "esptool-mac",
      "esptool-linux",
      "*.bin"
    ],
    "win": {
      "sign": "./signWin.js",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/",
      "target": [
        "deb",
        "AppImage"
      ]
    },
    "dmg": {
      "sign": false,
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  }
}
